# --- Telegram ---
# Токен бота от @BotFather.
# ⚠️ Для локальной разработки заведи ОТДЕЛЬНОГО dev-бота у @BotFather и используй его токен,
#    а не прод-токен. Прод-контейнер непрерывно держит long polling на прод-токене — если
#    поллить тем же токеном локально, Telegram отдаёт 409 Conflict и произвольно чередует,
#    какой процесс получает апдейты (реальные пользователи бота в Telegram страдают).
#    См. BOT_POLLING ниже — по умолчанию локально polling выключен именно поэтому.
BOT_TOKEN=123456:ABC-DEF...

# HTTP-прокси ТОЛЬКО для запросов к Telegram Bot API (host 127.0.0.1, без авторизации).
# Укажи свой порт локального прокси. Если оставить пустым — Telegram идёт напрямую.
# На OpenRouter и прочие запросы прокси НЕ влияет.
# ⚠️ В Docker на сервере 127.0.0.1 = сам контейнер. Адресуй прокси по ИМЕНИ
#    его контейнера в общей сети: http://<имя_прокси_контейнера>:<порт>
TELEGRAM_PROXY_URL=http://127.0.0.1:8080

# --- База данных ---
# Строка подключения к Postgres.
# ⚠️ В Docker на сервере вместо localhost — ИМЯ контейнера postgres в общей сети:
#    postgres://USER:PASS@<имя_postgres_контейнера>:5432/<db>
DATABASE_URL=postgres://user:password@localhost:5432/tg_rp_bot

# --- LLM ---
# Ключа/модели DeepSeek в env больше нет — это BYOK: каждый пользователь задаёт свой ключ
# и модель DeepSeek в Mini App (/settings → «ИИ (DeepSeek)»), хранится зашифрованным в БД
# (ENCRYPTION_KEY ниже). Без сохранённого ключа генерация/ИИ-перевод вернут ошибку пользователю.

# Ключ Tavily (https://tavily.com) для прототипа веб-поиска (src/scripts/test-web-search.ts).
# Временно в env для теста — позже станет BYOK по аналогии с DeepSeek.
TAVILY_API_KEY=

# --- Mini App ---
# Публичный HTTPS-URL развёрнутого webapp (для кнопки запуска из /start)
WEBAPP_URL=
# Порт локального HTTP-сервера API Mini App
PORT=3000

# --- Шифрование ---
# Ключ шифрования данных пользователей в БД (AES-256-GCM).
# Сгенерировать: node -e "import('node:crypto').then(c=>console.log(c.randomBytes(32).toString('hex')))"
# ⚠️ Один и тот же ключ локально и на сервере (локальный DATABASE_URL = прод-БД).
# ⚠️ Потеря ключа = зашифрованные данные безвозвратно недоступны.
ENCRYPTION_KEY=

# --- Прочее ---
# debug | info | warn | error
LOG_LEVEL=info

# --- Dev-обход авторизации (ТОЛЬКО для локальной разработки) ---
# Позволяет открыть Mini App в обычном браузере (localhost) без Telegram-контекста:
# сервер подставит указанного пользователя вместо проверки подписи initData.
# Укажи свой РЕАЛЬНЫЙ Telegram user id (например, через @userinfobot) — иначе
# dev-юзер не будет видеть никаких персонажей/чатов в прод-БД.
# ⚠️ Работает только когда NODE_ENV != production — на проде переменная запрещена
#    (бот упадёт при старте, если её случайно оставить).
# ⚠️ Не задавай, если не нужен обход — по умолчанию Mini App работает только из Telegram.
DEV_USER_ID=

# --- Long polling локально ---
# Запускать ли grammY long polling локально (bot.start()). В проде всегда включён (NODE_ENV=production),
# локально по умолчанию ВЫКЛЮЧЕН — см. предупреждение у BOT_TOKEN выше. Поставь true, только если
# используешь отдельный dev-бот и осознанно хочешь погонять его живьём в Telegram.
BOT_POLLING=
